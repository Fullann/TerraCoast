Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ne pas réécrire les vraies ressources (fichiers, dossiers)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Tout le reste → index.html (React Router gère)
  RewriteRule ^ index.html [L]
</IfModule>

# Gestion du cache HTTP et En-têtes de Sécurité
<IfModule mod_headers.c>
  # 1. En-têtes de sécurité recommandés (OWASP)
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  Header set X-XSS-Protection "1; mode=block"

  # 2. index.html et fichiers de contrôle (Service Worker, Manifest) : JAMAIS mis en cache navigateur
  <FilesMatch "(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 3. Assets versionnés (chunks JS, CSS, fonts avec hash Vite) : Cache fort et immuable
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Optionnel : Désactiver la signature du serveur
ServerSignature Off
